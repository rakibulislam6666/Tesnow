# ============================================
# TESNOW — Environment Configuration
# ============================================
# Copy this file to .env and update the values.
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
# ============================================


# ============================================
# APPLICATION
# ============================================

NODE_ENV=development

APP_NAME=Tesnow

APP_URL=http://localhost:8080

PORT=8080

HOST=0.0.0.0

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false


# ============================================
# DATABASE
# ============================================

DB_HOST=localhost
DB_PORT=8080
DB_NAME=tesnow_db
DB_USER=root
DB_PASSWORD=root

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000


# ============================================
# SESSION
# ============================================

# MUST be replaced with a long random secret.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

SESSION_NAME=tesnow.sid

# 7 days in milliseconds.
SESSION_MAX_AGE=604800000

# Set true when using HTTPS in production.
SESSION_SECURE=false

SESSION_HTTP_ONLY=true

# Recommended values: strict, lax, none
SESSION_SAME_SITE=lax


# ============================================
# SECURITY
# ============================================

CSRF_ENABLED=true

RATE_LIMIT_ENABLED=true

# 15 minutes in milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window.
RATE_LIMIT_MAX=100

# Password hashing cost.
BCRYPT_ROUNDS=12


# ============================================
# CORS
# ============================================

CORS_ORIGIN=http://localhost:3000

CORS_CREDENTIALS=true


# ============================================
# LOGGING
# ============================================

# fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Development only.
LOG_PRETTY=true


# ============================================
# EMAIL
# ============================================

SMTP_HOST=smtp.example.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=CHANGE_ME_SMTP_USERNAME

SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

MAIL_FROM=noreply@example.com


# ============================================
# STORAGE
# ============================================

# local or future providers such as s3.
STORAGE_DRIVER=local

UPLOAD_DIR=./storage/uploads

# 5 MB in bytes.
MAX_FILE_SIZE=5242880


# ============================================
# API
# ============================================

API_PREFIX=/api

API_VERSION=v1


# ============================================
# SEO
# ============================================

SITE_NAME=Tesnow

SITE_URL=http://localhost:3000


# ============================================
# FUTURE INTEGRATIONS
# ============================================

# ---------- OAuth ----------
# OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
# OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME
# OAUTH_GITHUB_CLIENT_ID=CHANGE_ME
# OAUTH_GITHUB_CLIENT_SECRET=CHANGE_ME


# ---------- CAPTCHA ----------
# CAPTCHA_PROVIDER=recaptcha
# CAPTCHA_SITE_KEY=CHANGE_ME
# CAPTCHA_SECRET_KEY=CHANGE_ME


# ---------- Redis / Cache ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=CHANGE_ME
# REDIS_DB=0


# ---------- Cloud Storage ----------
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_REGION=CHANGE_ME
# S3_BUCKET=CHANGE_ME


# ---------- Analytics ----------
# ANALYTICS_PROVIDER=CHANGE_ME
# ANALYTICS_ID=CHANGE_ME


# ---------- Payment ----------
# STRIPE_SECRET_KEY=CHANGE_ME
# STRIPE_WEBHOOK_SECRET=CHANGE_ME


# ============================================
# DEVELOPMENT & TESTING
# ============================================

# Use a completely separate database for tests.
TEST_DATABASE_URL=mysql://tesnow_test:CHANGE_ME@localhost:3306/tesnow_test_db

TEST_PORT=3001

TEST_LOG_LEVEL=error