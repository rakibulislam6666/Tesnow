# ============================================
# TESNOW — Git Ignore
# ============================================
# Security-focused ignore rules for Tesnow
# Node.js + Express.js + MySQL
#
# NEVER commit real secrets, credentials,
# private keys, runtime uploads, logs or backups.
# ============================================


