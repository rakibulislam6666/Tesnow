.env.*
!.env.example
!.env.template

*.pem
*.key
*.crt
*.p12
*.pfx
*.csr

secrets/
credentials/

*.secret
*.private

config/local.*
config/*.local.json
config/*.local.js


# ============================================
# NODE.JS
# ============================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

